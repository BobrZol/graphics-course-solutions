#version 430

layout(local_size_x = 32, local_size_y = 32) in;

layout(binding = 0, rgba8) uniform image2D resultImage;

layout(push_constant) uniform Push {
    vec4 time_res;
} pc;

float sdSphere(vec3 p, float r)
{
    return length(p) - r;
}

float sdBox(vec3 p, vec3 b)
{
    vec3 d = abs(p) - b;
    return length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);
}

float mapLedge(vec3 p)
{
    float ledge = max(sdSphere(p, 1.015),
                      -sdBox(p - vec3(2, 0.34, 0.25), vec3(2, 0.3, 0.3)));
    ledge = max(ledge, -sdBox(p - vec3(1, 0.7, -0.4), vec3(2, 4, 0.1)));
    ledge = max(ledge, -sdBox(p - vec3(1, 0.7, 0.8),  vec3(2, 4, 0.05)));
    ledge = max(ledge, -sdBox(p - vec3(1, 0.7, 0.8),  vec3(2, 0.09, 4)));
    ledge = max(ledge, -sdBox(p - vec3(1, -0.65, 0.8), vec3(2, 0.04, 4)));
    ledge = max(ledge, -sdBox(p - vec3(1, -0.3, 0.8),  vec3(2, 0.04, 4)));
    ledge = max(ledge, -sdBox(p, vec3(0.07, 4, 4)));
    ledge = max(ledge, -sdBox(p - vec3(1, 0.7, 0.2), vec3(4, 4, 0.1)));

    float equatorial_trough = sdBox(p, vec3(5, 0.05, 5));
    ledge = max(ledge, -equatorial_trough);
    return ledge;
}

float map(vec3 p)
{
    float death_star          = sdSphere(p, 1.0);
    float core                = sdSphere(p, 0.94);
    float laser_focusing_lens = sdSphere(p - vec3(1.7, 0.75, 0.5), 1.0);
    float equatorial_trough   = sdBox(p, vec3(5, 0.05, 5));

    float ledge = mapLedge(p);

    return min(min(max(max(death_star, -equatorial_trough), -laser_focusing_lens), core), ledge);
}

vec3 calcNormal(vec3 p)
{
    vec2 e = vec2(0.001, 0.0);
    return normalize(vec3(
        map(p + e.xyy) - map(p - e.xyy),
        map(p + e.yxy) - map(p - e.yxy),
        map(p + e.yyx) - map(p - e.yyx)));
}

vec2 rayMarch(vec3 ro, vec3 rd)
{
    float dO = 0.0;
    for (int i = 0; i < 100; i++)
    {
        vec3  p  = ro + rd * dO;
        float dS = map(p);
        dO += dS;
        if (abs(dS) < 0.001) return vec2(dO, 1.0);
        if (dO > 100.0)      return vec2(dO, 0.0);
    }
    return vec2(dO, 0.0);
}

float calcLighting(vec3 p, vec3 n)
{
    vec3 lightPos = vec3(1.0, 1.0, 3.0);
    vec3 l = normalize(lightPos - p);
    return max(dot(n, l), 0.0);
}

float random(vec2 st)
{
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

vec3 drawStars(vec3 rd)
{
    vec2 uv = vec2(atan(rd.x, rd.z), asin(rd.y));
    uv *= 20.0;
    vec2  grid = floor(uv);
    float rnd  = random(grid);

    if (rnd > 0.75)
    {
        vec2 cellPos = fract(uv) - 0.5;
        vec2 offset  = vec2(random(grid + 13.0), random(grid + 78.0)) - 0.5;
        cellPos -= offset * 0.4;

        float dist  = length(cellPos);
        float size  = 0.02 + rnd * 0.04;
        float star  = smoothstep(size, 0.0, dist);
        vec3  tint  = mix(vec3(1.0, 0.9, 0.8), vec3(0.8, 0.9, 1.0), random(grid + 42.0));

        return star * tint;
    }
    return vec3(0.0);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    float iTime       = pc.time_res.x;
    vec2  iResolution = vec2(pc.time_res.y, pc.time_res.z);

    vec2 uv = (fragCoord - 0.5 * iResolution) / iResolution.y;

    float radius = 4.0;
    float height = 0.0;
    float speed  = 1.0;

    vec3 ro = vec3(
        cos(iTime * speed) * radius,
        height,
        sin(iTime * speed) * radius);

    vec3 target  = vec3(0.0, 0.0, 0.0);
    vec3 forward = normalize(target - ro);
    vec3 right   = normalize(cross(vec3(0.0, 1.0, 0.0), forward));
    vec3 up      = cross(forward, right);
    vec3 rd      = normalize(forward + uv.x * right + uv.y * up);

    vec2 result = rayMarch(ro, rd);

    if (result.x < 100.0)
    {
        vec3  p     = ro + rd * result.x;
        vec3  n     = calcNormal(p);
        float light = calcLighting(p, n);

        float ledgeDist  = mapLedge(p);
        float sphereDist = sdSphere(p, 1.0);

        vec3 baseColor = (ledgeDist < sphereDist + 0.01)
            ? vec3(0.45, 0.45, 0.45)
            : vec3(0.6,  0.6,  0.6);

        vec3 color = baseColor * (0.4 + 0.6 * light);
        fragColor = vec4(color, 1.0);
    }
    else
    {
        vec3 stars    = drawStars(rd);
        vec3 skyColor = vec3(0.02, 0.02, 0.05) + stars;
        fragColor = vec4(skyColor, 1.0);
    }
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    int width  = int(pc.time_res.y);
    int height = int(pc.time_res.z);

    if (pixel.x >= width || pixel.y >= height)
        return;

    // Shadertoy: y растёт снизу вверх, у нас — сверху вниз. Переворачиваем.
    vec2 fragCoord = vec2(float(pixel.x), float(height) - float(pixel.y));

    vec4 color;
    mainImage(color, fragCoord);

    imageStore(resultImage, pixel, color);
}